{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Mongo": { "DatabaseName": "sentinel" },
  "RagApi": { "BaseUrl": "http://127.0.0.1:8000/api/v1/", "TimeoutSeconds": 330 },
  "Jwt": { "Issuer": "Sentinel.Middleware", "Audience": "Sentinel.React", "AccessMinutes": 15, "RefreshDays": 14 },
  "Frontend": { "AuthCallbackUrl": "http://127.0.0.1:5173" },
  "Authentication": { "EnableDevelopmentLogin": false }
}
